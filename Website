            <div className="bg-[#FAF8F5] p-4 rounded-xl border-2 border-black text-xs space-y-1.5">
              <p className="font-black text-black">AI Pitch Transcript:</p>
              <p className="text-black/80 font-medium italic">"{selectedCandidate.transcript}"</p>
            </div>

            <div className="flex space-x-3 pt-2">
              <button onClick={() => { toggleBookmark(selectedCandidate.id); setSelectedCandidate(null); }} className="flex-1 py-2.5 bg-white hover:bg-pink-100 border-2 border-black shadow-[3px_3px_0px_#000] text-black font-black text-xs rounded-xl cursor-pointer">
                {bookmarkedIds.includes(selectedCandidate.id) ? "Saved ⭐" : "Save Profile ⭐"}
              </button>
              <button onClick={() => { setSelectedCandidate(null); setCurrentPage('contact'); }} className="flex-1 py-2.5 bg-[#CCFF00] hover:bg-[#b8e600] border-2 border-black shadow-[3px_3px_0px_#000] text-black font-black text-xs rounded-xl cursor-pointer">
                Fast-Track Interview ⚡
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Neo-Brutalist Site Footer */}
      <footer className="mt-auto border-t-2 border-black bg-white py-6 px-4 text-center text-xs text-black space-y-2">
        <div className="flex flex-wrap items-center justify-center gap-2">
          <p className="font-black uppercase tracking-wide">CIVX India (www.civxindia.com) ⚡ End-to-End AI Recruitment</p>
          <button
            onClick={handleCopyDomain}
            className="px-2.5 py-1 rounded-lg bg-[#CCFF00] hover:bg-[#b8e600] border border-black font-black text-[10px] uppercase cursor-pointer"
          >
            {copiedDomain ? "Copied Link! ✅" : "Copy Website Link 🔗"}
          </button>
        </div>
        <p className="font-bold text-black/70">Ditch boring resumes. Screen faster, cut hiring costs by 75%, and hire cracked talent.</p>
      </footer>
    </div>
  );
}
