// 1. Fetch & filter candidates
app.get('/api/candidates', (req, res) => {
  try {
    const { search = '', category = 'All' } = req.query;
    const filtered = CANDIDATES.filter((c) => {
      const matchesSearch =
        c.name.toLowerCase().includes(search.toLowerCase()) ||
        c.role.toLowerCase().includes(search.toLowerCase()) ||
        c.city.toLowerCase().includes(search.toLowerCase()) ||
        c.skills.some((s) => s.toLowerCase().includes(search.toLowerCase()));
      const matchesCategory = category === 'All' || c.category === category;
      return matchesSearch && matchesCategory;
    });
    res.json({ success: true, candidates: filtered });
  } catch (err) {
    res.status(500).json({ success: false, error: 'Failed to load candidates' });
  }
});

// 2. AI Video Pitch Vibe Check Endpoint
app.post('/api/analyze-pitch', (req, res) => {
  try {
    const { role = 'Software Engineer' } = req.body;
    setTimeout(() => {
      res.json({
        success: true,
        analysis: {
          role,
          confidence: Math.floor(89 + Math.random() * 8),
          clarity: Math.floor(90 + Math.random() * 8),
          wordsPerMinute: Math.floor(135 + Math.random() * 15),
          transcript: `Namaste hiring team! I am excited to introduce myself for the ${role} role. I bring hands-on project execution, structured problem-solving, and high energy to your team!`,
          strengths: [
            "Outstanding vocal clarity & posture alignment",
            "Structured pitch using STAR technique",
            "Includes quantifiable project outcomes"
          ]
        }
      });
    }, 800);
  } catch (err) {
    res.status(500).json({ success: false, error: 'AI Analysis failed' });
  }
});

// 3. Submit Demo Booking Endpoint
app.post('/api/book-demo', (req, res) => {
  try {
    const { name, email, organization, message } = req.body;
    if (!name || !email) {
      return res.status(400).json({ success: false, error: 'Name and email are required.' });
    }
    const entry = {
      id: DEMO_REQUESTS.length + 1,
      name,
      email,
      organization,
      message,
      createdAt: new Date().toISOString()
    };
    DEMO_REQUESTS.push(entry);
    console.log('New Demo Request Saved:', entry);
    res.json({ success: true, message: 'Demo request locked in!', booking: entry });
  } catch (err) {
    res.status(500).json({ success: false, error: 'Could not save booking' });
  }
});

