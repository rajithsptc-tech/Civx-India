    <p class="font-black uppercase">CIVX India (www.civxindia.com) ⚡ Powered by Node.js & Express</p>
    <p class="font-bold text-black/70">Ditch boring resumes. Screen faster, cut hiring costs by 75%, and hire cracked talent.</p>
  </footer>

  <!-- Client-Side Interactive JS communicating with Node.js APIs -->
  <script>
    function switchPage(pageId) {
      document.querySelectorAll('.page-section').forEach(el => el.classList.remove('active'));
      document.getElementById('page-' + pageId).classList.add('active');

      document.querySelectorAll('.nav-tab').forEach(btn => {
        btn.className = 'nav-tab px-3.5 py-1.5 rounded-xl text-xs font-black text-black/70 hover:text-black cursor-pointer';
      });
      const activeBtn = document.getElementById('nav-' + pageId);
      if (activeBtn) {
        activeBtn.className = 'nav-tab px-3.5 py-1.5 rounded-xl text-xs font-black bg-[#CCFF00] border-2 border-black neo-shadow-sm cursor-pointer';
      }
      if (pageId === 'recruiters') loadCandidates();
    }

    async function loadCandidates() {
      const search = document.getElementById('talent-search').value;
      const category = document.getElementById('talent-category').value;
      const res = await fetch(\`/api/candidates?search=\${encodeURIComponent(search)}&category=\${encodeURIComponent(category)}\`);
      const data = await res.json();
      const grid = document.getElementById('candidates-grid');
      grid.innerHTML = data.candidates.map(c => \`
        <div class="bg-[#FAF8F5] border-2 border-black neo-shadow-sm rounded-2xl p-4 space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <img src="\${c.avatar}" class="w-12 h-12 rounded-xl object-cover border-2 border-black" />
              <span class="px-2.5 py-1 rounded-full bg-[#CCFF00] border border-black text-[10px] font-black">\${c.matchScore}% MATCH 🔥</span>
            </div>
            <h3 class="text-base font-black">\${c.name}</h3>
            <p class="text-xs text-violet-700 font-extrabold">\${c.role}</p>
            <p class="text-[11px] text-black/70 font-bold">\${c.city} • \${c.experience}</p>
            <div class="flex flex-wrap gap-1">
              \${c.skills.map(s => \`<span class="px-2 py-0.5 rounded bg-white border border-black text-[10px] font-bold">\${s}</span>\`).join('')}
            </div>
          </div>
          <button onclick='openModal(\${JSON.stringify(c)})' class="w-full mt-3 py-2 bg-black hover:bg-violet-600 text-white border-2 border-black font-black text-xs rounded-xl cursor-pointer">
            ▶ Watch 60s Pitch
          </button>
        </div>
      \`).join('');
    }

    function openModal(c) {
      document.getElementById('modal-name').innerText = c.name;
      document.getElementById('modal-role').innerText = c.role + ' • ' + c.experience;
      const vid = document.getElementById('modal-video');
      vid.src = c.videoUrl;
      document.getElementById('modal-transcript').innerText = '"' + c.transcript + '"';
      document.getElementById('video-modal').classList.remove('hidden');
      vid.play();
    }

    function closeModal() {
      const vid = document.getElementById('modal-video');
      vid.pause();
      document.getElementById('video-modal').classList.add('hidden');
    }

    async function runVibeCheck() {
      const btn = document.getElementById('vibe-btn');
      const role = document.getElementById('pitch-role').value;
      btn.innerText = 'AI Cooking Feedback...';
      const res = await fetch('/api/analyze-pitch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ role })
      });
      const { analysis } = await res.json();
      btn.innerText = 'Run Instant AI Vibe Check ✨';
      document.getElementById('ai-scorecard').innerHTML = \`
        <h3 class="text-sm font-black uppercase">✨ Your AI Scorecard (\${analysis.role})</h3>
        <div class="grid grid-cols-3 gap-2 text-center">
          <div class="bg-[#CCFF00] p-2.5 rounded-xl border-2 border-black"><p class="text-[10px] font-black">CONFIDENCE</p><p class="text-lg font-black">\${analysis.confidence}%</p></div>
          <div class="bg-pink-200 p-2.5 rounded-xl border-2 border-black"><p class="text-[10px] font-black">CLARITY</p><p class="text-lg font-black">\${analysis.clarity}%</p></div>
          <div class="bg-cyan-200 p-2.5 rounded-xl border-2 border-black"><p class="text-[10px] font-black">PACE</p><p class="text-lg font-black">\${analysis.wordsPerMinute} WPM</p></div>
        </div>
        <p class="text-xs bg-white p-3 rounded-xl border-2 border-black italic">"\${analysis.transcript}"</p>
        <ul class="text-xs font-bold list-disc list-inside">
          \${analysis.strengths.map(s => \`<li>\${s}</li>\`).join('')}
        </ul>
      \`;
    }

    function updateROI() {
      const hires = Number(document.getElementById('input-hires').value);
      const cost = Number(document.getElementById('input-cost').value);
      document.getElementById('label-hires').innerText = hires + ' Hires';
      document.getElementById('label-cost').innerText = '₹' + cost.toLocaleString('en-IN');
      const saved = Math.round(hires * cost * 0.75);
      document.getElementById('roi-saved').innerText = '₹' + saved.toLocaleString('en-IN');
    }

    async function submitDemoForm(e) {
      e.preventDefault();
      const payload = {
        name: document.getElementById('demo-name').value,
        email: document.getElementById('demo-email').value,
        organization: document.getElementById('demo-org').value,
        message: document.getElementById('demo-msg').value
      };
      const res = await fetch('/api/book-demo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      const status = document.getElementById('demo-status');
      status.innerText = '🔒 ' + data.message + ' We will reach out to ' + payload.email + ' shortly.';
      status.classList.remove('hidden');
      document.getElementById('demo-form').reset();
    }

    loadCandidates();
  </script>
</body>
</html>`);
});

// Start Express Server
app.listen(PORT, () => {
  console.log(\`🚀 CIVX India (www.civxindia.com) Node.js server running at http://localhost:\${PORT}\`);
});
